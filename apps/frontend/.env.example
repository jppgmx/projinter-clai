# URL base da API. Em dev, "/api" passa pelo proxy do Vite.
VITE_API_URL=/api
# Para onde o proxy do Vite encaminha /api em desenvolvimento.
# 4040 = backend rodando direto com ./mvnw spring-boot:run
# 8080 = backend rodando pelo docker-compose-dev.yml
VITE_API_PROXY_TARGET=http://localhost:4040
# "true" = rotas sem endpoint no back end (login, dashboard) respondem por MSW.
# Rotas que o MSW nao conhece (/api/estudantes, /api/estudos-caso...) vao para o back end real.
VITE_USE_MOCKS=true
